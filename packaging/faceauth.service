[Unit]
Description=Omarchy FaceAuth daemon (camera, templates, verdicts for pam_faceauth)
Documentation=https://github.com/mellismas/omarchy-faceauth
# Started at boot as a plain service. Never socket- or D-Bus-activated and never
# started from anything inside a PAM stack: an on-demand start would recurse
# through polkit into the PAM stack that contains pam_faceauth.
# The camera is opened per request, so no settled /dev is needed at start.
# The only boot-time device is the TPM, which systemd orders through
# tpm2.target (pulled in by its generator when firmware reports one).
After=tpm2.target

[Service]
Type=simple
ExecStart=/usr/bin/faceauthd /etc/faceauth/config.toml
Restart=on-failure
RestartSec=2
RuntimeDirectory=faceauth
RuntimeDirectoryMode=0755
# A crash and its restart are not an outage (fix round 11). systemd keeps
# /run/faceauth through an automatic restart and through `systemctl
# restart`, and removes it only once the unit is stopped, or failed with no
# restart to come (v262 src/core/unit.c, unit_release_resources). The PAM
# module counts the daemon as down, and gives sudo and polkit the stock
# key, only when the directory is gone; a socket missing or refusing inside
# it is a daemon restarting, and goes to the password.
RuntimeDirectoryPreserve=restart
# The kernel's OOM killer picks the daemon late (fix round 11): a restart
# it forces is not an outage either, but it costs every request.
OOMScoreAdjust=-500
StateDirectory=faceauth
StateDirectoryMode=0700
ConfigurationDirectory=faceauth
# Root (the default) because the camera nodes and the template store are
# root-owned, but with no capabilities at all: opening root-owned devices,
# binding the socket and writing the store need none, and the session lock
# goes through PID 1.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Inert while User=root (hidepid exempts the procfs gid), kept for the day
# the daemon runs as its own user; the locality check does not rely on it.
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# ONNX Runtime's CPU provider runs all three models without a writable and
# executable mapping (the engine's `mdwe` test loads and runs each under
# the same prctl), so the daemon keeps W^X.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
# The TPM resource manager, for sealing templates through systemd-creds.
DeviceAllow=/dev/tpmrm0 rw
# StateDirectory= and RuntimeDirectory= above already make /var/lib/faceauth
# and /run/faceauth writable. /etc/sudoers.d is here for one file:
# /etc/sudoers.d/99-omarchy-nopasswd-<user>, the passwordless-sudo rule the
# consent card can arm (the same file omarchy-sudo-passwordless writes),
# which the daemon places and its timer removes. ReadWritePaths= is
# directory-granular, so the one file cannot be named on its own; nothing
# else under /etc is writable.
ReadWritePaths=/etc/sudoers.d
UMask=0077
# Unsealed templates live in memory; a core dump would write them to disk.
LimitCORE=0
# The pipeline is about 300 MB resident with the recognition model loaded
# and about 60 MB with it released; each load peaks near 740 MB for half
# a second. A runaway is killed well before the system is.
MemoryMax=1024M
# Tasks are threads and processes together. At most: the idle daemon's 7
# (TasksCurrent, measured live) and the presence watch's lock call (the
# helper, `timeout` and `systemd-run`); one thread per connection place, up
# to the largest max_connections the config takes (MAX_CONNECTIONS_CAP,
# 128, config.rs; 64 by default); and one per consent request of the one
# user whose requests hold the window (CONSENT_PER_UID, 32,
# consent/state.rs), which wait without a place. Any request may be running
# a call into the user's session, `timeout` plus `systemd-run`, so each
# counts three. The security key adds five: the watch of the request on
# screen, its systemd-run, the timeout and systemctl that stop a check, and
# the next watch waiting for that stop (consent/key.rs; the check itself
# runs in a unit of its own). The nod window's lock watches add six: at
# most two hold a thread (LOCK_WATCHES_MAX, consent/wait.rs), the window's
# own and one still finishing a look after its window ended, each with its
# look's `timeout` and `systemd-run`. A key unlock from the lock screen,
# or a sudo or polkit stack's key-fallback line, holds a place with one
# task more, its check's systemd-run beside the lock check or the stop it
# makes. The lock screen's reserved channels (round 7) sit outside the
# places, a thread each, at most 32 (server/channel.rs), with one
# listener thread:
# (128 + 32) * 3 + 128 + 32 + 7 + 3 + 5 + 1 + 6 = 662. With that
# room, a burst of one user's requests meets CONSENT_PER_UID's clean
# refusal before the daemon cannot start a thread and drops other users'
# requests (D6). serve.rs's
# the_units_tasks_max_holds_every_request_the_daemon_admits holds this line
# to the constants.
TasksMax=666
# The daemon logs at info unless RUST_LOG says otherwise; nothing to set here.

[Install]
WantedBy=multi-user.target
