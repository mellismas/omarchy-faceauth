[Unit]
Description=Omarchy FaceAuth daemon (camera, templates, verdicts for pam_faceauth)
Documentation=https://github.com/basecamp/omarchy
# Started at boot as a plain service. Never socket- or D-Bus-activated and never
# started from anything inside a PAM stack: an on-demand start would recurse
# through polkit into the PAM stack that contains pam_faceauth.
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/bin/faceauthd /etc/faceauth/config.toml
Restart=on-failure
RestartSec=2
RuntimeDirectory=faceauth
RuntimeDirectoryMode=0755
StateDirectory=faceauth
StateDirectoryMode=0700
ConfigurationDirectory=faceauth
# Root because the camera nodes and the template store are root-owned, but
# with no capabilities at all: opening root-owned devices, binding the socket
# and writing the store need none, and the session lock goes through PID 1.
User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Inert while User=root (hidepid exempts the procfs gid), kept for the day
# the daemon runs as its own user; the locality check does not rely on it.
ProtectProc=invisible
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# ONNX Runtime JIT-compiles kernels; this is the one W^X concession, named here
# so a reviewer sees it.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=char-video4linux rw
DeviceAllow=char-media rw
# The TPM resource manager, for sealing templates through systemd-creds.
DeviceAllow=/dev/tpmrm0 rw
ReadWritePaths=/var/lib/faceauth /run/faceauth /etc/sudoers.d
UMask=0077
# Unsealed templates live in memory; a core dump would write them to disk.
LimitCORE=0
# The recognition model is ~700 MB resident; a runaway is killed well before
# the system is.
MemoryMax=1536M
TasksMax=64
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
