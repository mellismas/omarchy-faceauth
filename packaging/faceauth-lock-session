#!/bin/bash
# Lock a user's Omarchy session from the faceauth daemon (root).
#   faceauth-lock-session <user> [omarchy-path]
# The lock command runs inside the user's own systemd manager, with that
# session's environment, so the daemon never switches uid itself: the service
# sandbox drops CAP_SETUID, and runuser/su would open a PAM session whose
# modules fail under it. OMARCHY_PATH must name the tree the running shell was
# launched from (the packaged one unless the desktop is dev-linked).
set -euo pipefail
user=${1:?user}
omarchy_path=${2:-$(sed -n 's/^OMARCHY_PATH=//p' /etc/omarchy.conf 2>/dev/null | tr -d '"' | head -1)}
omarchy_path=${omarchy_path:-/usr/share/omarchy}
exec /usr/bin/systemd-run --machine="$user@.host" --user --wait --collect --quiet \
  -E "OMARCHY_PATH=$omarchy_path" omarchy-system-lock
